{
  "manifest_version": 3,
  "name": "Evil Mention",
  "version": "1.0",
  "description": "Flashes an image on a YouTube video when a chosen word is said.",
  "icons": { "128": "icon128.png" },
  "content_scripts": [
    { "matches": ["*://www.youtube.com/*"], "js": ["content.js"] }
  ],
  "web_accessible_resources": [
    { "resources": ["1.png", "2.png", "3.png", "boom.wav"], "matches": ["*://www.youtube.com/*"] }
  ]
}
